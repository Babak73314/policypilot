# PolicyPilot local configuration.
# Do not copy this file by hand: run `python scripts/init_env.py` (or `docker compose run --rm init-env`).
# It writes `.env` with random values for every `change-me` placeholder and never overwrites an
# existing `.env`. The API refuses to start while a placeholder is still in place.

# --- application
APP_ENV=local
APP_SECRET_KEY=change-me
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# --- database (Docker Compose `db` service; published on 127.0.0.1 only)
DB_PORT=5432
POSTGRES_PASSWORD=change-me
POLICYPILOT_DB_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
# Used by tools running on the host (tests, `uv run policypilot ...`). Containers build their own URL.
DATABASE_URL=postgresql+psycopg://policypilot:change-me@127.0.0.1:5432/policypilot

# --- models (optional: without a key the scripted demo model is used)
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_FALLBACK_PROVIDER=none
OPENAI_API_KEY=

# --- demo agent and local machine tokens (created by `policypilot seed`)
SEED_AGENT_EMAIL=agent@policypilot.test
SEED_AGENT_PASSWORD=change-me
MCP_DEV_TOKEN=change-me
N8N_INTEGRATION_TOKEN=change-me

# --- WhatsApp (simulator by default; cloud mode needs real Meta values)
WHATSAPP_MODE=simulator
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=change-me
WHATSAPP_VERIFY_TOKEN=change-me

# --- n8n
N8N_WEBHOOK_TOKEN=change-me
N8N_ENCRYPTION_KEY=change-me
